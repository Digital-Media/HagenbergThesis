%% This package provides the documentation of the usage of generative AI tools in a thesis,
%% which is placed after the affidavit (i.e., after \maketitle):
%%   - environment 'aiusage': short form, composed of text modules,
%%   - environment 'aiusagedetails': detailed form with confirmations and a table of activities.
%% All texts are printed in the title page language (class option 'titlelanguage').
%%
%% The texts of the detailed form are taken from: Gimpel, H., Dilger, P., Lämmermann, L., Urbach, N. (2023).
%% COGNISANCE: Declaration of Generative AI Tool Usage in Higher Education Tests. Research Center for
%% Information Management. These texts are licensed under CC BY-SA 4.0
%% (https://creativecommons.org/licenses/by-sa/4.0/); the source is printed below the detailed form.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hgbaiusage}[2026/09/12]%%AUTO

\RequirePackage{hgbdict}
\RequirePackage{etoolbox}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{amssymb}	% check boxes (\square, \boxtimes)

\newcommand{\hgb@AIUsageGet}[1]{\hgbDictionaryGet{#1}{\hgb@TitleLanguage}}

%% ----------------------------------------------------------------------------
%% Short form (text modules)
%% ----------------------------------------------------------------------------

\hgbDictionarySet{aiusage-title}{english}{Documentation of AI Tools Usage}
\hgbDictionarySet{aiusage-title}{german}{Dokumentation der Nutzung von KI-Tools}

\hgbDictionarySet{aiusage-intro}{english}{%
