% Academic degrees (class option 'degree=<key>'; the level is taken from the class option 'type').
% Usage: \hgbDefineDegree{<key>}{<bachelor degree>}{<master degree>}
% An empty argument means that the degree does not exist at this level.
% Degree names are the same in all languages.
\newcommand{\hgbDefineDegree}[3]{%
	\if\relax\detokenize{#2}\relax\else
		\hgbDictionarySet{degree-bachelor-#1}{english}{#2}%
		\hgbDictionarySet{degree-bachelor-#1}{german}{#2}%
	\fi
	\if\relax\detokenize{#3}\relax\else
		\hgbDictionarySet{degree-master-#1}{english}{#3}%
		\hgbDictionarySet{degree-master-#1}{german}{#3}%
	\fi
}

