% Not possible for dialects based on a language without dialect (HTML, Scala, XML), since the empty base
% dialect would then refer to the default dialect itself; these are selected explicitly in the environments.

%% Code environments -----------------------------------------------------------

% \hgb@NewCodeEnvironment{<environment>}{<language>}: code environment for the given language, with
% LaTeX escapes between /+ and +/ (e.g., for labels of lines), options as optional argument
\newcommand{\hgb@NewCodeEnvironment}[2]{%
	\lstnewenvironment{#1}[1][]{\lstset{language={#2},escapeinside={/+}{+/},##1}}{}%
}

\hgb@NewCodeEnvironment{CCode}{C}				% C (C23)
\hgb@NewCodeEnvironment{CppCode}{C++}			% C++ (C++23)
\hgb@NewCodeEnvironment{CsCode}{CSharp}			% C#
\hgb@NewCodeEnvironment{CssCode}{CSS}			% CSS
\hgb@NewCodeEnvironment{HtmlCode}{[hgb]HTML}	% HTML5
\hgb@NewCodeEnvironment{JavaCode}{Java}			% Java
\hgb@NewCodeEnvironment{JsCode}{JavaScript}		% JavaScript
\hgb@NewCodeEnvironment{LaTeXCode}{[hgb]TeX}	% LaTeX
\hgb@NewCodeEnvironment{ObjCCode}{ObjectiveC}	% Objective-C
\hgb@NewCodeEnvironment{PhpCode}{PHP}			% PHP
\hgb@NewCodeEnvironment{PythonCode}{Python}		% Python 3
\hgb@NewCodeEnvironment{ScalaCode}{[hgb]Scala}	% Scala 3
\hgb@NewCodeEnvironment{SwiftCode}{Swift}		% Swift
\hgb@NewCodeEnvironment{XmlCode}{[hgb]XML}		% XML

% Code environment for generic code (no language, no escapes)
\lstnewenvironment{GenericCode}[1][]
{\lstset{%
	language={},
	keepspaces=true,
	commentstyle={},
	texcl=false,
	escapechar={},
	escapeinside={},
	#1}}
{}


% Disable the lstlisting environment (due to popular abuse)
\newcommand{\@WarnLstlisting}{
\GenericError{}{Package hgblistings Error: The 'lstlisting' environment is disabled}%
{See the error note inserted in the document output for details.}{}%
\begin{quote}
\color{red}\textbf{NOTE:} The \texttt{lstlisting} environment has been deliberately disabled in this setup.
Use \emph{inline code} (breakable and \emph{without} a caption) or create a \emph{float container} with
\texttt{{\textbackslash}begin\{program\} \ldots {\textbackslash}end\{program\}} instead!
See the \texttt{hgbthesis} tutorial for examples.
\end{quote}%
}
\renewenvironment{lstlisting}[0]%
{\@WarnLstlisting\expandafter\comment}%
{\expandafter\endcomment}%
