%% Title page following the FH OÖ title page prototype for theses (2025-10-22).
%% The copyright, declaration and company pages are inherited from theme 'classic'.
%% The brand (logo and institution name) is kept separate from the layout and set by
%% \hgb@SetBrand (see below). This theme always uses the current official brand, i.e., it switches from FH OÖ
%% to UAP automatically as soon as the UAP logo file is available; brand themes (e.g., 'fhooe26', 'uap27') pin
%% a specific brand.

\ProvidesPackage{hgbtheme-default}[2026/04/12]%%AUTO
\hgb@UseTheme{classic}%	parent theme
\RequirePackage{hgbdict}
\RequirePackage{forloop}
\RequirePackage[absolute]{textpos}

% All positions on the title page are given in mm from the top left corner of the page:
\setlength{\TPHorizModule}{1mm}
\setlength{\TPVertModule}{1mm}

%% Define various language-dependent text chunks to be used below -------------

\hgbDictionarySet{academic-degree-intro}{german}{zur Erlangung des akademischen Grades}%
\hgbDictionarySet{academic-degree-intro}{english}{to obtain the academic degree of}%

\hgbDictionarySet{submission-year}{german}{Jahr der Einreichung}%
\hgbDictionarySet{submission-year}{english}{Year of submission}%

% label on the title page for advisors specified by \advisor{..} without optional argument:
\hgbDictionarySet{supervision}{german}{Betreuung}%
\hgbDictionarySet{supervision}{english}{Supervision}%

%% Brand (logo and institution name) ------------------------------------------

% Usage: \hgb@SetBrand[<logo height>]{<logo file>}{<institution name german>}{<institution name english>}
% The institution name is used on the title page unless \institution{..} is specified in the document.
% A theme that calls \hgb@SetBrand pins its brand, i.e., the automatic switch to the UAP brand (see below)
% is turned off.
\newif\ifhgb@BrandAuto
\hgb@BrandAutotrue
\newcommand{\hgb@SetBrand}[4][28mm]{%
	\hgb@BrandAutofalse
	\hgb@@SetBrand[#1]{#2}{#3}{#4}%
}
\newcommand{\hgb@@SetBrand}[4][28mm]{%
	\setlength{\hgb@LogoHeight}{#1}%	length defined in theme 'classic'
	\renewcommand{\hgb@LogoFile}{#2}%
	\hgbDictionarySet{institution-name}{german}{#3}%
	\hgbDictionarySet{institution-name}{english}{#4}%
}

\renewcommand{\hgb@Institution}{\hgbDictionaryGet{institution-name}{\hgb@TitleLanguage}}

% Brands of the institution:
% - FH OÖ (until 2027-01-18), logo 28mm high.
% - UAP (from 2027-01-18): the logo file 'hgbtheme-uap27-logo.pdf' (umbrella brand with the English name and
%   the German descriptor, cropped tightly) is not part of the package before the official launch. The logo is
%   31.5mm high, i.e., the word mark 'UAP' is about 12mm high, and the clear space (height of the 'U') to the top
%   of the page is kept. The institution name is the English long form in both languages, as specified for
%   scientific publications.
\newcommand{\hgb@SetBrandFHOOE}{%
	\hgb@@SetBrand{hgbtheme-fhooe26-logo.pdf}{Fachhochschule Oberösterreich}{University of Applied Sciences Upper Austria}}
\newcommand{\hgb@UAPLogoFile}{hgbtheme-uap27-logo.pdf}
\newcommand{\hgb@SetBrandUAP}{%
	\hgb@@SetBrand[31.5mm]{\hgb@UAPLogoFile}{University of Applied Sciences Upper Austria}{University of Applied Sciences Upper Austria}}

% True (#2) if the graphics file #1 is found in the document directory, in the directories of \graphicspath
% (e.g., 'images/') or in the TeX installation, otherwise false (#3):
\newcommand{\hgb@IfGraphicsFileExists}[3]{%
	\begingroup
	\ifdefined\Ginput@path
		\ifdefined\input@path
			\edef\input@path{\input@path\Ginput@path}%
		\else
			\let\input@path\Ginput@path
		\fi
	\fi
	\IfFileExists{#1}{\endgroup#2}{\endgroup#3}%
}

% Current official brand: FH OÖ, or UAP as soon as the UAP logo file is available. The file is looked up before
% \maketitle (when \graphicspath is known), so that it is sufficient to add it to the document (e.g., to the
% directory 'images/'). Themes that pin a brand (e.g., 'fhooe26', 'uap27') are not affected.
\hgb@SetBrandFHOOE
\AddToHook{hgb@InitThemeHook}{%
	\ifhgb@BrandAuto
		\hgb@IfGraphicsFileExists{\hgb@UAPLogoFile}%
			{\hgb@SetBrandUAP\typeout{hgbtheme-default: using the UAP brand (logo file '\hgb@UAPLogoFile' found)}}%
			{\typeout{hgbtheme-default: using the FH OÖ brand (logo file '\hgb@UAPLogoFile' not found)}}%
	\fi
}%

%% Fonts of the title page ----------------------------------------------------

\newcommand{\hgb@TitlePageSizeNormal}{\fontsize{16}{19}\selectfont}%	author, thesis type
\newcommand{\hgb@TitlePageSizeTitle}{\fontsize{24}{31.5}\selectfont}%	title (bold)
\newcommand{\hgb@TitlePageSizeSmall}{\fontsize{14}{23}\selectfont}%		year of submission, supervision

%% Initialization (optional) --------------------------------------------------

\AddToHook{hgb@InitThemeHook}{%
	% add initialization code if needed
}%

%% Title page -----------------------------------------------------------------

\renewcommand{\hgb@MakeTitlePage}{%
\begin{titlepage}%
	\hgb@TitlePageFont%
	\setlength{\parindent}{0pt}%

	% logo --------------------------------------------------
	\begin{textblock}{155}(25,12)
		\hgb@MakeLogo%	defined in theme 'classic'
	\end{textblock}

	% author, title, thesis type, academic degree (flowing text) --------------
	\begin{textblock}{155}(25,64)
		\raggedright
		{\hgb@TitlePageSizeNormal\hgb@Author\par}%
		\vspace{10.8mm}%
		\begin{SwitchLanguage}{\hgb@MainLanguage}% thesis title is assumed to be in main document language!
			{\hgb@TitlePageSizeTitle\bfseries\hgb@FullTitle\par}%
		\end{SwitchLanguage}%
		\vspace{18.7mm}%
		{\hgb@TitlePageSizeNormal\hgb@ThesisName%
			\ifthenelse{\boolean{hgb@IsProposal}}{\space(\hgb@ProposalName)}{}\par}%
		\ifthenelse{\equal{\hgb@AcademicDegree}{} \OR \boolean{hgb@IsProposal}}%
			{}% no academic degree specified, or proposal (not submitted to obtain the degree)
			{%
				\vspace{3.2mm}%
				{\fontsize{16}{25.8}\selectfont%
					\hgbDictionaryGet{academic-degree-intro}{\hgb@TitleLanguage}\\
					\hgb@AcademicDegree\par}%
			}%
	\end{textblock}

	% program type, program name, institution, place of study ---------------
	\begin{textblock}{155}(25,209.5)
		\raggedright
		\fontsize{16}{20.4}\selectfont
		\hgb@ProgramType\par
		\hgb@ProgramName\par
		\hgb@Institution\par
		\hgb@PlaceOfStudy\par
	\end{textblock}

	% year of submission, advisor(s) (not for internship reports), bottom aligned
	\begin{textblock}{155}[0,1](25,280)
		\raggedright
		\hgb@TitlePageSizeSmall
		\hgb@MakeSubmissionTable\par% defined below
	\end{textblock}

	\null%	required to tell LaTeX that there is a non-empty content box
\end{titlepage}%
}

%% Submission Table (title page) ----------------------------------------
%% Year of submission and advisors in one bottom-aligned table, so that all rows
%% have the same distance and the table grows upwards with more advisors.
%% Advisors without explicit role are labeled "Betreuung"/"Supervision";
%% consecutive advisors with the same role share one label.
%% (The company page of internship reports uses \@makeAdvisorTable of theme 'classic'.)

\newcounter{hgb@advisor}

\newcommand{\hgb@MakeSubmissionTable}{%
	\begingroup
	\renewcommand{\arraystretch}{1.0}%
	\begin{tabular}[b]{@{}l@{\space}l@{}}%
		\multicolumn{2}{@{}l@{}}{\hgbDictionaryGet{submission-year}{\hgb@TitleLanguage}: \hgb@SubmissionYear}%
		\ifthenelse{\equal{\hgb@ThesisType}{internship}}%
			{}% no advisors on the title page of internship reports
			{%
				\ifthenelse{\hgb@AdvisorCount > 0}%
					{%
						\forloop{hgb@advisor}{1}{\not{\value{hgb@advisor} > \hgb@AdvisorCount}}{%   see 'forloop' package
							\\
							\ifthenelse{\value{hgb@advisor} > 1 \AND
									\equal{\hgb@getAdvisorRole{\thehgb@advisor}}{\hgb@getAdvisorRole{\the\numexpr\value{hgb@advisor}-1\relax}}}%
								{}% same role as the previous advisor
								{%
									\ifthenelse{\equal{\hgb@getAdvisorRole{\thehgb@advisor}}{\hgbDictionaryGet{advisorheader}{\hgb@TitleLanguage}}}%
										{\hgbDictionaryGet{supervision}{\hgb@TitleLanguage}:}% default role
										{\hgb@getAdvisorRole{\thehgb@advisor}:}%
								}%
							& \hgb@getAdvisorName{\thehgb@advisor}%
						}%
					}%
					{\\ \multicolumn{2}{@{}l@{}}{\color{red}No advisor(s) specified!}}%
			}%
	\end{tabular}%
	\endgroup
}
