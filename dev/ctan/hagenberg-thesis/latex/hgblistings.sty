%% File encoding: UTF-8

\ProvidesPackage{hgblistings}[2026/09/14]%%AUTO

\RequirePackage{xifthen}
\RequirePackage{textcomp}	%% required for upquote option
\RequirePackage{xcolor}

%% Package options -------------------------------------------------------------

% codestyle=color|mono|classic: style of the code listings (default: color). Usually given as class option
% of hgbthesis, hgbreport or hgbarticle, which pass it on to this package.
\newcommand{\hgb@CodeStyle}{color}
\DeclareKeys[hgblistings]{
	codestyle.code = {%
		\ifthenelse{\equal{#1}{color} \OR \equal{#1}{mono} \OR \equal{#1}{classic}}%
			{\renewcommand{\hgb@CodeStyle}{#1}}%
			{\PackageError{hgblistings}{Unknown value '#1' for option 'codestyle'}%
				{Allowed values are color (default), mono and classic.}}},
}
\ProcessKeyOptions[hgblistings]

%% Colors ----------------------------------------------------------------------

% Syntax colors close to the "Light+" theme of Visual Studio Code (keywords in the color of the algorithms
% in hgbalgo.sty), each with a contrast ratio of at least 4.5:1 against white (WCAG AA). Comments are also set
% in italics, so they do not depend on color alone. Defined in RGB (PDF/A); they can be redefined with
% \definecolor in the preamble of a document.
\definecolor{ListingsKeywordColor}{rgb}{0.00,0.00,0.666}	% keywords (dark blue, same as AlgKeywordColor)
\definecolor{ListingsTypeColor}{HTML}{267F99}				% built-in types and functions (teal)
\definecolor{ListingsStringColor}{HTML}{A31515}				% strings (dark red)
\definecolor{ListingsCommentColor}{HTML}{008000}			% comments (green)
\definecolor{ListingsLineNumberColor}{gray}{0.45}			% line numbers (styles 'color' and 'mono')
\definecolor{ListingsRuleColor}{gray}{0.75}					% rule left of the code (styles 'color' and 'mono')
\definecolor{ListingsBackgroundColor}{gray}{0.95}			% background (style 'classic')

%% Basic settings (all styles) -------------------------------------------------

\RequirePackage{listingsutf8}
\lst@RequireAspects{directives,tex}	% keys 'directivestyle' and 'texcsstyle' are used in the styles below
\lstset{
	inputencoding=utf8,
	extendedchars=true,
	basicstyle=\ttfamily\footnotesize,
	showstringspaces=false,
	columns=flexible,
	breaklines=true,
	tabsize=2,
	numbers=left,
	numbersep=5pt,
	stepnumber=1,
	numberfirstline=true,
	numberblanklines=true,
	texcl=false,		% program comments are not read as LaTeX content
	mathescape=false,	% no math escape by default
	upquote=true,
	keepspaces=true,
}

%% Styles ----------------------------------------------------------------------

% 'classic': previous look (gray box, no syntax highlighting)
\lstdefinestyle{hgbclassic}{
	backgroundcolor=\color{ListingsBackgroundColor},
	frame=none,
	framerule=0.4pt,		% defaults of listings, reset when switching from another style
	framesep=3pt,
	xleftmargin=6mm,
	framexleftmargin=6mm,
	numbersep=5pt,
	numberstyle=\normalfont\scriptsize,
	keywordstyle={},
	keywordstyle={[2]},
	identifierstyle={},
	commentstyle=\normalfont\itshape,
	stringstyle=\ttfamily,
	directivestyle={},
	texcsstyle={},
}

% 'mono': white background with a thin rule left of the code (between line numbers and code), no colors
\lstdefinestyle{hgbmono}{
	backgroundcolor={},
	frame=l,
	framerule=0.8pt,
	rulecolor=\color{ListingsRuleColor},
	xleftmargin=8mm,		% code
	framesep=2mm,			% rule 2mm left of the code
	framexleftmargin=0mm,
	numbersep=4mm,			% line numbers 2mm left of the rule
	numberstyle=\normalfont\scriptsize\color{ListingsLineNumberColor},
	keywordstyle={},
	keywordstyle={[2]},
	identifierstyle={},
	commentstyle=\ttfamily\itshape,
	stringstyle=\ttfamily,
	directivestyle={},
	texcsstyle={},
}

% 'color': like 'mono', with syntax colors
\lstdefinestyle{hgbcolor}{
	style=hgbmono,
	keywordstyle=\color{ListingsKeywordColor},
	keywordstyle={[2]\color{ListingsTypeColor}},
	commentstyle=\color{ListingsCommentColor}\ttfamily\itshape,
	stringstyle=\color{ListingsStringColor}\ttfamily,
	directivestyle=\color{ListingsKeywordColor},
	texcsstyle=*\color{ListingsKeywordColor},
}

% Apply the selected style (can be changed per listing, e.g., \begin{JavaCode}[style=hgbmono]):
\edef\@tempa{\noexpand\lstset{style=hgb\hgb@CodeStyle}}\@tempa

\RequirePackage[utf8]{inputenc}
\lstset{literate=% to allow Umlauts etc. in listed code % utf8-change
{Ö}{{\"O}}1
{Ä}{{\"A}}1
{Ü}{{\"U}}1
{ü}{{\"u}}1
{ä}{{\"a}}1
{ö}{{\"o}}1
{ß}{{\ss}}2
}

%% Language definitions --------------------------------------------------------
%% Keywords of current language versions. Languages that are also defined by listings are extended or replaced
%% by the dialect [hgb]; where possible, it is set as default dialect, so that e.g. language=Java (also in
%% \lstinputlisting) selects [hgb]Java. Keyword classes: 1 = keywords (ListingsKeywordColor),
%% 2 = built-in types, functions and annotations (ListingsTypeColor).

